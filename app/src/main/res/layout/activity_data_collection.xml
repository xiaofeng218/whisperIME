<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_blue_light"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_white">

                <!-- Navigation Tabs -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/navigation_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:tabIndicatorColor="@color/primary_blue"
                    app:tabSelectedTextColor="@color/primary_blue"
                    app:tabTextColor="@color/text_gray"
                    app:tabRippleColor="@null"
                    android:background="@color/surface_white">
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_speech_recognition" />
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_voice_collection" />
                </com.google.android.material.tabs.TabLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_light" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:orientation="horizontal">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/voice_collection_title"
                        android:textColor="@color/primary_blue"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportTxt"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_text"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/bg_blue_light"
                        android:textColor="@color/primary_blue"
                        app:icon="@drawable/ic_copy" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvCollectionProgressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/collection_progress_default"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_gray" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/tvCollectionPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50%"
                            android:textSize="12sp"
                            android:textColor="@color/primary_blue"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/collection_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="4dp"
                        android:progress="50"
                        android:progressDrawable="@drawable/custom_progress_bar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Focus Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:background="@color/surface_white">

                    <TextView
                        android:id="@+id/tvTargetText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/collection_sample_text"
                        android:textColor="@color/text_dark"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="8dp" />

                    <TextView
                        android:id="@+id/tvCollectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:text="@string/collection_status_ready"
                        android:textColor="@color/text_gray"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/upload_loading"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <!-- Playback Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayRecording"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/play_my_recording"
                        android:visibility="invisible"
                        app:icon="@drawable/ic_play_arrow_24dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/bg_blue_light"
                        android:textColor="@color/primary_blue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRelogin"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:text="@string/relogin"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/surface_white"
                app:icon="@drawable/ic_account_circle"
                app:iconTint="@color/primary_blue"
                app:iconSize="20dp"
                app:elevation="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_arrow_back_24dp"
                android:alpha="0.3"
                android:scaleType="fitCenter"
                android:padding="12dp"
                app:tint="@color/primary_blue" />

            <ImageButton
                android:id="@+id/btnRecordCollection"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/rounded_button_blue"
                android:elevation="8dp"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic_48dp"
                app:tint="@color/surface_white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:icon="@drawable/ic_arrow_forward_24dp"
                app:iconSize="32dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/primary_blue"
                android:textColor="@color/primary_blue"
                android:textStyle="bold"
                android:padding="0dp"
                app:cornerRadius="32dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            
            <View
                android:layout_width="64dp"
                android:layout_height="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
